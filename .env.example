# NAQL AI — environment variables
# Only NEXT_PUBLIC_* values are exposed to the browser. Never put secrets there.

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_LOCALE=ar

# ---------- API ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Requests allowed per client per minute. Keep the default in production; the
# isolated Playwright runner raises it only for its private test API process.
RATE_LIMIT_MAX=100

# Required when NODE_ENV=production. The API refuses to start without it in production.
# Local embedded cluster started by `pnpm --filter @naql/api db:dev`:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/naql_ai?schema=public
# DATABASE_URL=postgresql://naql:naql@127.0.0.1:5433/naql_ai?schema=public
# Prisma CLI migrations should use the Neon direct (non-pooler) URL in production.
# For local development, point this at the same local database as DATABASE_URL.
DIRECT_URL=postgresql://naql:naql@127.0.0.1:5433/naql_ai?schema=public

# Comma-separated allow-list. Required in production; open in development.
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-in-production
# Required in production: a random value of at least 32 characters. The API
# refuses to start with the development default when NODE_ENV=production.
# Token lifetimes use the <number><s|m|h|d> form.
JWT_EXPIRES_IN=12h
ADMIN_JWT_EXPIRES_IN=8h

# Local file storage. Leave empty for the in-memory development map.
# Required in production; the API refuses to start without it.
# The directory must be outside the web root and writable by the API process.
STORAGE_PATH=
# S3-compatible object storage is not implemented in this build. The variables
# below are reserved and must not be treated as active configuration.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

REDIS_URL=

# ---------- Secure documents and retention ----------
# Maximum decoded upload size. The API body limit must remain above base64+JSON overhead.
MAX_DOCUMENT_BYTES=2097152
# none | clamav. "none" reports not_scanned and never claims a file is clean.
MALWARE_SCANNER=none
MALWARE_SCANNER_HOST=127.0.0.1
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=5000
# A configured scanner that cannot answer rejects the upload when true.
MALWARE_SCAN_FAIL_CLOSED=true
# Retention in days. 0 disables expiry. Run scripts/documents-retention.ts
# without --apply first, then with --apply after reviewing the report.
DOCUMENT_RETENTION_DAYS=0
COMPANY_DOCUMENT_RETENTION_DAYS=0

# ---------- Document extraction service ----------
# Optional Python FastAPI service used for PDF text extraction and image OCR.
# It is not required for text-based documents or deterministic extraction.
AI_SERVICE_URL=http://127.0.0.1:8000
# Per-request timeout for the extraction service and the AI gateway.
AI_REQUEST_TIMEOUT_MS=30000

# ---------- AI model gateway ----------
# none | openai | openai-compatible | ollama
# "none" is the default. Deterministic extraction, consistency, retrieval,
# risk and Copilot summaries keep working without a paid model provider.
# When configured, AI_API_KEY and AI_BASE_URL are server-side only.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Bounded retries for transient provider failures (0-3).
AI_MAX_RETRIES=1
# Image OCR requires the Python service plus tesseract; leave false until installed.
AI_OCR_ENABLED=false
# Maximum deterministic retrieval chunks sent to the Copilot context (1-20).
AI_RAG_TOP_K=5

# ---------- External notification delivery ----------
# none | resend. "none" persists in-app notifications only and never claims an
# email was sent. Resend requires a verified sender/domain and a server-side key.
# Configuration alone remains UNVERIFIED until a controlled delivery succeeds.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
# Verified sender, for example: NAQL <notifications@your-domain.example>
EMAIL_FROM=
EMAIL_REQUEST_TIMEOUT_MS=10000

# ---------- UN Comtrade (international trade statistics) ----------
# Optional subscription key pair issued at comtradeplus.un.org. When absent,
# the server uses the official key-free Public API preview endpoints. Keys remain
# server-side and are never exposed to the browser. Never commit real keys.
COMTRADE_API_BASE_URL=https://comtradeapi.un.org
COMTRADE_API_KEY=
COMTRADE_API_KEY_SECONDARY=

# Integration health never treats configured credentials as proof of availability.
# The admin registry probes PostgreSQL and the extraction service, while paid or
# government integrations remain UNVERIFIED until an authorized operation succeeds.

# ---------- Platform administration ----------
# Explicit authorisation for the provisioning CLI. There is no public endpoint
# that grants a platform role. Set this only while running
# `pnpm --filter @naql/api admin -- ...`, then remove it. Minimum 16 characters;
# it must differ from JWT_SECRET.
ADMIN_BOOTSTRAP_SECRET=
# CI-only: pass the initial administrator password to the CLI without a TTY.
# Prefer the interactive masked prompt. Never commit a real value.
# NAQL_ADMIN_PASSWORD=
