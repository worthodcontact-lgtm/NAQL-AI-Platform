# NAQL AI — environment variables
# Only NEXT_PUBLIC_* values are exposed to the browser. Never put secrets there.

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_LOCALE=ar

# ---------- API ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Required when NODE_ENV=production. The API refuses to start without it in production.
# Local embedded cluster started by `pnpm --filter @naql/api db:dev`:
DATABASE_URL=postgresql://naql:naql@127.0.0.1:5433/naql_ai?schema=public

# Comma-separated allow-list. Required in production; open in development.
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-in-production
# Required in production: a random value of at least 32 characters. The API
# refuses to start with the development default when NODE_ENV=production.
# Token lifetimes use the <number><s|m|h|d> form.
JWT_EXPIRES_IN=12h
ADMIN_JWT_EXPIRES_IN=8h

# Local file storage. Leave empty for the in-memory development map.
STORAGE_PATH=
# S3-compatible object storage (production)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

REDIS_URL=

# ---------- AI service ----------
AI_SERVICE_URL=http://127.0.0.1:8000
AI_REQUEST_TIMEOUT_MS=5000

# Provider selection: none | ollama | openai | anthropic
# When set to "none" (or left empty) every AI endpoint returns an explicitly
# labelled unavailability response instead of a fabricated answer.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------- UN Comtrade (international trade statistics) ----------
# Subscription key pair issued at comtradeplus.un.org and used against
# comtradeapi.un.org. Primary and secondary are interchangeable. Read by the
# server-side trade client only; never exposed to the browser. Never commit real keys.
COMTRADE_API_BASE_URL=https://comtradeapi.un.org
COMTRADE_API_KEY=
COMTRADE_API_KEY_SECONDARY=

# ---------- Platform administration ----------
# Explicit authorisation for the provisioning CLI. There is no public endpoint
# that grants a platform role. Set this only while running
# `pnpm --filter @naql/api admin -- ...`, then remove it. Minimum 16 characters;
# it must differ from JWT_SECRET.
ADMIN_BOOTSTRAP_SECRET=
# CI-only: pass the initial administrator password to the CLI without a TTY.
# Prefer the interactive masked prompt. Never commit a real value.
# NAQL_ADMIN_PASSWORD=
