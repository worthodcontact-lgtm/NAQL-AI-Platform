generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  memberships Membership[]
  shipments   Shipment[]
  quotationRequests QuotationRequest[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  displayName    String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  memberships    Membership[]
  /// active | suspended — a suspended account cannot authenticate or use any token.
  status         String       @default("active")
  /// SUPER_ADMIN | ADMIN | REVIEWER | SUPPORT. Null for ordinary users.
  /// Platform authority is never derived from an organization membership.
  platformRole   String?
  /// Incremented on suspension, platform-role change, or password reset. Tokens
  /// carrying an older value are rejected, so privilege changes take effect at once.
  sessionVersion Int          @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([platformRole])
  @@index([status])
  @@index([createdAt])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  /// A user may hold several roles in one organization (e.g. REVIEWER + DATA_OPERATOR).
  /// The same role cannot be granted twice for the same membership pair.
  @@unique([organizationId, userId, role])
  @@index([userId])
}

model Port {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  country   String
  latitude  Float
  longitude Float
  /// seaport | airport | inland | border
  type      String     @default("seaport")
  /// Human-readable source of the reference record.
  source    String?
  /// approximate | verified | unverified — never claim more than is known.
  verificationStatus String @default("approximate")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shipmentsFrom Shipment[] @relation("OriginPort")
  shipmentsTo   Shipment[] @relation("DestinationPort")

  @@index([country, type])
}

model Shipment {
  id                String             @id @default(cuid())
  reference         String             @unique
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId   String
  originPortId      String
  destinationPortId String
  originPort        Port               @relation("OriginPort", fields: [originPortId], references: [id])
  destinationPort   Port               @relation("DestinationPort", fields: [destinationPortId], references: [id])
  mode              String
  incoterm          String
  status            String             @default("DRAFT")
  cargoDescription  String
  weightKg          Decimal
  volumeCbm         Decimal?
  milestones        ShipmentMilestone[]
  quotationRequests QuotationRequest[]
  documents         Document[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
}

model ShipmentMilestone {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  code       String
  label      String
  status     String   @default("pending")
  occurredAt DateTime?
}

model QuotationRequest {
  id             String         @id @default(cuid())
  shipmentId     String
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String         @default("open")
  requestedAt    DateTime       @default(now())
  offers         QuotationOffer[]
}

model QuotationOffer {
  id                  String           @id @default(cuid())
  quotationRequestId  String
  quotationRequest    QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
  providerId          String
  currency            String
  amount              Decimal
  transitDays         Int
  validityUntil       DateTime
}

model Document {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type        String
  filename    String
  storageKey  String
  status      String   @default("uploaded")
  validation  String?
  uploadedAt  DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  /// Platform role held by the actor at the time of the action.
  actorRole      String?
  action         String
  entityType     String
  entityId       String?
  /// success | denied | failure
  outcome        String   @default("success")
  /// Correlates the event with the request that produced it.
  requestId      String?
  /// JSON string. Never contains passwords, tokens, or other credentials.
  metadata       String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
}

model PlatformSetting {
  /// Whitelisted key. Arbitrary environment variables are never stored here.
  key             String   @id
  value           String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

model Company {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  type               String
  status             String              @default("draft")
  verificationStatus String              @default("unregistered")
  listed             Boolean             @default(false)
  description        String?
  country            String?
  website            String?
  email              String?
  phone              String?
  organizationId     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  services           CompanyService[]
  documents          CompanyDocument[]
  reviews            VerificationReview[]
  rfqRecipients      RfqRecipient[]
  quotes             Quote[]

  @@index([organizationId])
  @@index([listed, type])
  @@index([verificationStatus])
}

model CompanyService {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mode               String
  originLocation     String?
  destinationLocation String?
  notes              String?
  createdAt          DateTime @default(now())
}

model CompanyDocument {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type       String
  filename   String
  storageKey String
  status     String   @default("uploaded")
  reviewNote String?
  uploadedAt DateTime @default(now())
}

model VerificationReview {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewerUserId String
  decision       String
  notes          String?
  createdAt      DateTime @default(now())
}

model Rfq {
  id                String         @id @default(cuid())
  organizationId    String
  createdByUserId   String
  origin            String
  destination       String
  mode              String
  cargoDescription  String
  weightKg          Decimal
  status            String         @default("submitted")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  recipients        RfqRecipient[]
  quotes            Quote[]
  bookings          BookingRequest[]

  @@index([organizationId, createdAt])
}

model RfqRecipient {
  id        String   @id @default(cuid())
  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status    String   @default("invited")
  invitedAt DateTime @default(now())

  @@unique([rfqId, companyId])
}

model Quote {
  id             String     @id @default(cuid())
  rfqId          String
  rfq            Rfq        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String
  currency       String
  totalAmount    Decimal
  transitDays    Int
  validityUntil  DateTime
  status         String     @default("submitted")
  createdAt      DateTime   @default(now())
  items          QuoteItem[]
  bookings       BookingRequest[]

  @@index([organizationId, createdAt])
  @@index([companyId])
}

model QuoteItem {
  id       String  @id @default(cuid())
  quoteId  String
  quote    Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label    String
  amount   Decimal
  currency String
  included Boolean @default(true)
}

model BookingRequest {
  id                String          @id @default(cuid())
  rfqId             String?
  rfq               Rfq?            @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  /// A booking is always derived from exactly one accepted quote.
  quoteId           String?         @unique
  quote             Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  organizationId    String
  createdByUserId   String
  status            String          @default("requested")
  confirmedAt       DateTime?
  externalReference String?
  rejectionReason   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  trackingEvents    TrackingEvent[]

  @@index([organizationId, createdAt])
  @@index([status])
}

model TrackingEvent {
  id               String         @id @default(cuid())
  bookingRequestId String
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  code             String
  label            String
  source           String         @default("manual")
  occurredAt       DateTime       @default(now())
}
