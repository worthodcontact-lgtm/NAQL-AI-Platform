{
  "name": "@naql/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --ext .ts",
    "test": "pnpm run prisma:generate && vitest run",
    "test:isolated": "node scripts/phase41-test-database.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:demo:remove": "tsx scripts/seed-demo.ts -- --remove",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "documents:retention": "tsx scripts/documents-retention.ts",
    "admin": "tsx scripts/admin-cli.ts",
    "admin:import-legacy": "tsx scripts/import-legacy-admins.ts",
    "db:dev": "node scripts/dev-db.mjs",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
